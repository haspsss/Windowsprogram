<Page x:Class="courseselect.Example.PersonalInformation.MyInformation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:courseselect.Example.PersonalInformation"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="我的信息">

    <Grid>
        <Label Content="学号：" HorizontalAlignment="Left" Margin="55,50,0,0" VerticalAlignment="Top"/>
        <Label Content="姓名：" HorizontalAlignment="Left" Margin="200,50,0,0" VerticalAlignment="Top"/>
        <Label Content="性别：" HorizontalAlignment="Left" Margin="345,50,0,0" VerticalAlignment="Top"/>
        <Label Content="出生日期：" HorizontalAlignment="Left" Margin="55,100,0,0" VerticalAlignment="Top"/>
        <Label Content="学院：" HorizontalAlignment="Left" Margin="220,100,0,0" VerticalAlignment="Top"/>
        <Label Content="专业：" HorizontalAlignment="Left" Margin="365,100,0,0" VerticalAlignment="Top"/>
        <Label Content="政治面貌：" HorizontalAlignment="Left" Margin="55,150,0,0" VerticalAlignment="Top"/>
        <Label Content="联系方式：" HorizontalAlignment="Left" Margin="220,150,0,0" VerticalAlignment="Top"/>
        <Button Content="修改密码" HorizontalAlignment="Left" Margin="470,155,0,0" VerticalAlignment="Top" Click="Changepwbtn_Click"/>

        <TextBox x:Name="SidTextBox" HorizontalAlignment="Left" Margin="100,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
        <TextBox x:Name="NameTextBox" HorizontalAlignment="Left" Margin="245,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
        <TextBox x:Name="SexTextBox" HorizontalAlignment="Left" Margin="390,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
        <TextBox x:Name="BirthTextBox" HorizontalAlignment="Left" Margin="120,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
        <TextBox x:Name="CollegeTextBox" HorizontalAlignment="Left" Margin="265,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
        <TextBox x:Name="MajorTextBox" HorizontalAlignment="Left" Margin="410,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
        <TextBox x:Name="PoliticalTextBox" HorizontalAlignment="Left" Margin="120,155,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
        <TextBox x:Name="PhoneTextBox" HorizontalAlignment="Left" Margin="285,155,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
    </Grid>
</Page>