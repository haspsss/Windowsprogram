<Page x:Class="courseselect.Example.Teacher.courseselect.选课页面"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:courseselect.Example.Teacher.courseselect"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="选课页面">
    <Page.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="AliceBlue">
                            <Track x:Name="PART_Track"
                           IsDirectionReversed="true"
                           Focusable="false">
                                
                                <Track.Thumb>
                                    <Thumb Background="LightSteelBlue" BorderBrush="Transparent"/>
                                </Track.Thumb>

                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="LightGoldenrodYellow" />
            <Setter Property="FontWeight" Value="bold"/>
            <Setter Property="Height" Value="25"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto">
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
            <TextBlock x:Name="CreditsSummaryTextBlock" 
             FontSize="16" 
             Margin="10" 
             FontWeight="Bold" 
             HorizontalAlignment="Right" />
            <TextBox x:Name="SearchTextBox" Width="200" Height="30" />
            <Button x:Name="SearchButton" Content="搜索" Click="SearchButton_Click"  Height="30"/>
                <Button Content="清除筛选" Click="ClearFilterButton_Click" Height="30"/>

                <Label Content="上课时间:"/>
                <ComboBox x:Name="CTimeComboBox" Width="120" SelectionChanged="FilterComboBox_SelectionChanged"  Height="30"/>
                <Label Content="开设学院:"/>
                <ComboBox x:Name="CCollegeComboBox" Width="120" SelectionChanged="FilterComboBox_SelectionChanged"  Height="30"/>
                <Label Content="课程类型:"/>
                <ComboBox x:Name="CKindComboBox" Width="120" SelectionChanged="FilterComboBox_SelectionChanged" Height="30"/>
                <Label Content="考察方式:"/>
                <ComboBox x:Name="TestComboBox" Width="120" SelectionChanged="FilterComboBox_SelectionChanged"  Height="30"/>
                <Label Content="上课周:"/>
                <ComboBox x:Name="CWeekComboBox" Width="120" SelectionChanged="FilterComboBox_SelectionChanged"  Height="30"/>
            </StackPanel>
        </ScrollViewer>

        <DataGrid x:Name="CourseDataGrid" Grid.Row="1" AutoGenerateColumns="False" Margin="5">
            <DataGrid.Columns>
               
                <DataGridTextColumn Header="剩余可选人数" Binding="{Binding RemainingSeats}" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Green" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RemainingSeats}" Value="0">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="课程编号" Binding="{Binding Cid}" />
                <DataGridTextColumn Header="课程名称" Binding="{Binding CName}" />
                <DataGridTextColumn Header="课程周几" Binding="{Binding CDay}" />
                <DataGridTextColumn Header="可容纳人数" Binding="{Binding CAccomdate}" />
                <DataGridTextColumn Header="课程学分" Binding="{Binding CCredit}" />
                <DataGridTextColumn Header="课程地点" Binding="{Binding CPlace}" />
                <DataGridTextColumn Header="课程考试时间" Binding="{Binding CTestTime}" />
                <DataGridTextColumn Header="课程类别" Binding="{Binding CKind}" />
                <DataGridTextColumn Header="课程介绍" Binding="{Binding CIntro}" />
                <DataGridTextColumn Header="课程所属学院" Binding="{Binding CCollege}" />
                <DataGridTextColumn Header="课程所属系" Binding="{Binding CDepartment}" />
                <DataGridTextColumn Header="课程所属专业" Binding="{Binding CMajor}" />
                <DataGridTextColumn Header="课程学年" Binding="{Binding CYear}" />
                <DataGridTextColumn Header="课程周次" Binding="{Binding CWeek}" />
                <DataGridTextColumn Header="课程节次" Binding="{Binding CTime}" />
                <DataGridTextColumn Header="课程考试地点" Binding="{Binding CTestPlace}" />
                <DataGridTextColumn Header="考察方式" Binding="{Binding CTest}" />
                <DataGridTextColumn Header="教师名称" Binding="{Binding TeacherName}" />

                <!-- 添加选课和退选按钮 -->

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
