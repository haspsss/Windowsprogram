<Window x:Class="courseselect.Example.Teacher.tChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:courseselect.Example.Teacher"
        mc:Ignorable="d"
        Title="tChangePasswordWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Label Content="原始密码：" />
            <TextBox x:Name="txtOldPassword" Width="500" HorizontalAlignment="Left"/>
            <Label Content="新密码：" />
            <TextBox x:Name="txtNewPassword" MaxLength="20" Width="500" HorizontalAlignment="Left"/>
            <Label Content="验证问题：" />
            <TextBox x:Name="txtQuestion" MaxLength="20" Width="500" HorizontalAlignment="Left"/>
            <Label Content="问题答案：" />
            <TextBox x:Name="txtAnswer" MaxLength="20" Width="500" HorizontalAlignment="Left"/>
            <Button Content="确认修改" Click="ConfirmChange_Click" />
        </StackPanel>
    </Grid>
</Window>
