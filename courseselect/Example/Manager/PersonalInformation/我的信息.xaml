<Page x:Class="courseselect.Example.Manager.PersonalInformation.我的信息"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:courseselect.Example.Manager.PersonalInformation"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="我的信息">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="LightGoldenrodYellow" />
            <Setter Property="FontWeight" Value="bold"/>
            <Setter Property="Height" Value="25"/>
        </Style>
        <Style TargetType="TextBox" >
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Page.Resources>
    <Grid>
       
                <Grid>
                    <Label Content="职工号：" HorizontalAlignment="Left" Margin="55,50,0,0" VerticalAlignment="Top"/>
                    <Label Content="姓名：" HorizontalAlignment="Left" Margin="210,50,0,0" VerticalAlignment="Top"/>
                    <Label Content="性别：" HorizontalAlignment="Left" Margin="355,50,0,0" VerticalAlignment="Top"/>
                    <Label Content="出生日期：" HorizontalAlignment="Left" Margin="55,100,0,0" VerticalAlignment="Top"/>
                    <Label Content="学院：" HorizontalAlignment="Left" Margin="225,100,0,0" VerticalAlignment="Top"/>
                    <Label Content="系：" HorizontalAlignment="Left" Margin="385,100,0,0" VerticalAlignment="Top"/>
                    <Label Content="政治面貌：" HorizontalAlignment="Left" Margin="55,150,0,0" VerticalAlignment="Top"/>
                    <Label Content="联系方式：" HorizontalAlignment="Left" Margin="220,150,0,0" VerticalAlignment="Top"/>
                    <Button Content="修改密码" HorizontalAlignment="Left" Margin="460,155,0,0" VerticalAlignment="Top" Click="Changepwbtn_Click"/>

                    <TextBox x:Name="ttidTextBox" HorizontalAlignment="Left" Margin="105,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
                    <TextBox x:Name="NameTextBox" HorizontalAlignment="Left" Margin="250,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
                    <TextBox x:Name="SexTextBox" HorizontalAlignment="Left" Margin="395,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
                    <TextBox x:Name="BirthTextBox" HorizontalAlignment="Left" Margin="120,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
                    <TextBox x:Name="CollegeTextBox" HorizontalAlignment="Left" Margin="265,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" IsReadOnly="True"/>
                    <TextBox x:Name="departmentTextBox" HorizontalAlignment="Left" Margin="410,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
                    <TextBox x:Name="PoliticalTextBox" HorizontalAlignment="Left" Margin="120,155,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
                    <TextBox x:Name="PhoneTextBox" HorizontalAlignment="Left" Margin="285,155,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
                </Grid>
            </Grid>
        </Page>
