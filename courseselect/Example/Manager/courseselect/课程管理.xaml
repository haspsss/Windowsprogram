<Page x:Class="courseselect.Example.Manager.courseselect.课程管理"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:courseselect.Example.Manager.courseselect"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="课程管理">
    <Page.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="AliceBlue">
                            <Track x:Name="PART_Track"
                               IsDirectionReversed="true"
                               Focusable="false">
                              
                                <Track.Thumb>
                                    <Thumb Background="LightSteelBlue"  BorderBrush="Transparent"/>
                                </Track.Thumb>
                               
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="LightGoldenrodYellow" />
            <Setter Property="FontWeight" Value="bold"/>
            <Setter Property="Height" Value="25"/>
        </Style>
    </Page.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
            <TextBlock x:Name="CreditsSummaryTextBlock" 
  FontSize="16" 
  Margin="10" 
  FontWeight="Bold" 
  HorizontalAlignment="Right" />
            <TextBox x:Name="SearchTextBox" Width="200" KeyDown="SearchTextBox_KeyDown"  Height="30"/>

            <Button x:Name="SearchButton" Content="搜索" Click="SearchButton_Click" Height="30"/>
            <Button Content="清空筛选" Width="80" Margin="0,0,10,0" Click="ClearFilters_Click" Height="30"/>

            <ComboBox x:Name="CTimeComboBox" Width="120" SelectionChanged="FilterComboBox_SelectionChanged"  Height="30"/>
            <ComboBox x:Name="CCollegeComboBox" Width="120" SelectionChanged="FilterComboBox_SelectionChanged"  Height="30"/>
            <ComboBox x:Name="CKindComboBox" Width="120" SelectionChanged="FilterComboBox_SelectionChanged" Height="30"/>
            <ComboBox x:Name="TestComboBox" Width="120" SelectionChanged="FilterComboBox_SelectionChanged"  Height="30"/>
            <ComboBox x:Name="CWeekComboBox" Width="120" SelectionChanged="FilterComboBox_SelectionChanged"  Height="30"/>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Margin="10"  Grid.Row="1">
                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="20,0,0,10">
                    <Button Content="添加课程" Width="100" Margin="0,0,10,0" Click="AddCourse_Click"/>
                <Button Content="保存修改" Width="100" Margin="0,0,10,0" Click="SaveChanges_Click"/>
                <Button Content="删除课程" Width="100" Margin="0,0,10,0"   Click="DeleteCourse_Click"/>
                


            </StackPanel>
       

        <!-- 课程表格展示 -->
                <DataGrid x:Name="CourseDataGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      ItemsSource="{Binding CourseList}" SelectionMode="Extended" SelectionUnit="FullRow"  >
                    <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="选择"
                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                        Width="50"
                        CanUserSort="False"/>

                    <DataGridTextColumn Header="课程号" Binding="{Binding Cid}" Width="80"/>
                        <DataGridTextColumn Header="课程名" Binding="{Binding CName}" Width="100"/>
                        <DataGridTextColumn Header="学院" Binding="{Binding CCollege}" Width="100"/>
                        <DataGridTextColumn Header="系" Binding="{Binding CDepartment}" Width="100"/>
                    <DataGridTextColumn Header="所属专业" Binding="{Binding CMajor}" Width="100"/>

                    <DataGridTextColumn Header="学分" Binding="{Binding CCredit}" Width="60"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding CKind}" Width="80"/>
                    <DataGridTextColumn Header="可容纳人数" Binding="{Binding CAccomDate}" Width="80"/>

                    <DataGridTextColumn Header="地点" Binding="{Binding CPlace}" Width="100"/>
                        <DataGridTextColumn Header="开课年" Binding="{Binding CYear}" Width="80"/>
                        <DataGridTextColumn Header="周数" Binding="{Binding CWeek}" Width="60"/>
                        <DataGridTextColumn Header="星期" Binding="{Binding CDay}" Width="60"/>
                    <DataGridTextColumn Header="上课时间" Binding="{Binding CTime}" Width="60"/>

                    <DataGridTextColumn Header="开始节数" Binding="{Binding CNum}" Width="80"/>
                        <DataGridTextColumn Header="持续节数" Binding="{Binding CLast}" Width="80"/>
                        <DataGridTextColumn Header="是否考试" Binding="{Binding CTest}" Width="80"/>
                        <DataGridTextColumn Header="考试开始" Binding="{Binding CTestTime}" Width="100"/>
                        <DataGridTextColumn Header="考试结束" Binding="{Binding CTestTimeEnd}" Width="100"/>
                        <DataGridTextColumn Header="考试地点" Binding="{Binding CTestPlace}" Width="100"/>
                    
                </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    
</Page>
