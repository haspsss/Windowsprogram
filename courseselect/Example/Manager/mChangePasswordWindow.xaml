<Window x:Class="courseselect.Example.Manager.mChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:courseselect.Example.Manager"
        mc:Ignorable="d"
        Title="修改密码" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="LightGoldenrodYellow" />
            <Setter Property="FontWeight" Value="bold"/>
            <Setter Property="Height" Value="25"/>
        </Style>
        <Style TargetType="TextBox" >
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <Grid>
       
                <StackPanel>
                    <Label Content="原始密码：" />
                    <TextBox x:Name="txtOldPassword" Width="500" HorizontalAlignment="Left"/>
                    <Label Content="新密码：" />
                    <TextBox x:Name="txtNewPassword" MaxLength="20" Width="500" HorizontalAlignment="Left"/>
                   
            <Button Content="确认修改" Click="ConfirmChange_Click"  Width="60" Margin="5,10,0,0"  HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
        </Window>
