<Page x:Class="courseselect.Example.Student.考试安排.考试信息"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:courseselect.Example.Student.考试安排"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="考试信息">
    <Grid Margin="20">
        <DataGrid ItemsSource="{Binding ExamCourses}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="课程编号" Binding="{Binding CID}" />
                <DataGridTextColumn Header="课程名称" Binding="{Binding CName}" />
                <DataGridTextColumn Header="教师" Binding="{Binding TeacherName}" />
                <DataGridTextColumn Header="考试开始时间" Binding="{Binding CTestTime, StringFormat='{}{0:yyyy年MM月dd日 HH:mm}'}" />
                <DataGridTextColumn Header="考试结束时间" Binding="{Binding CTestTimeEnd, StringFormat='{}{0:yyyy年MM月dd日 HH:mm}'}" />

                <DataGridTextColumn Header="考试状态" Binding="{Binding ExamStatus}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
