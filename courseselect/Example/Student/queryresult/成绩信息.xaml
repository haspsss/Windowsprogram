<Page x:Class="courseselect.Example.Student.queryresult.成绩信息"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:courseselect.Example.Student.queryresult"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="成绩信息">
    <Page.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="AliceBlue">
                            <Track x:Name="PART_Track"
                            IsDirectionReversed="true"
                            Focusable="false">

                                <Track.Thumb>
                                    <Thumb Background="LightSteelBlue"  BorderBrush="Transparent"/>
                                </Track.Thumb>

                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </Page.Resources>
    <Grid>
        <DataGrid ItemsSource="{Binding GradeList}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="课程编号" Binding="{Binding CID}" />
                <DataGridTextColumn Header="课程名称" Binding="{Binding CName}" />
                <DataGridTextColumn Header="开设学院" Binding="{Binding CCollege}" />
                <DataGridTextColumn Header="课程类型" Binding="{Binding CKind}" />
                <DataGridTextColumn Header="学分" Binding="{Binding CCredit}" />
                <DataGridTextColumn Header="成绩" Binding="{Binding Score}" />
                <DataGridTextColumn Header="教师姓名" Binding="{Binding TName}" />
                <DataGridTextColumn Header="教师编号" Binding="{Binding TTID}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
