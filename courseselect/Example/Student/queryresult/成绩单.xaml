<Page x:Class="courseselect.Example.Student.queryresult.成绩单"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:courseselect.Example.Student.queryresult"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="成绩单">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="LightGoldenrodYellow" />
            <Setter Property="FontWeight" Value="bold"/>
            <Setter Property="Height" Value="25"/>
        </Style>
        </Page.Resources>
        <Grid x:Name="MainGrid" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Content="导出为PDF" HorizontalAlignment="Left" Margin="1,0,0,10" Width="100"
 Click="ExportButton_Click" Grid.ColumnSpan="3" Grid.Row="0"/>
        <DataGrid ItemsSource="{Binding GradeList}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="30" Grid.Row="1">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSummary}" Value="True">
                            <Setter Property="Background" Value="AliceBlue"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="学年" Binding="{Binding AcademicYear}" Width="*"/>
                <DataGridTextColumn Header="课程编号" Binding="{Binding CID}" Width="*"/>
                <DataGridTextColumn Header="课程名称" Binding="{Binding CName}" Width="*"/>
                <DataGridTextColumn Header="学分" Binding="{Binding CCredit}" Width="*"/>
                <DataGridTextColumn Header="成绩" Binding="{Binding Score}" Width="*"/>
                <DataGridTextColumn Header="绩点" Binding="{Binding GPA, StringFormat=F2}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        
    </Grid>
</Page>
