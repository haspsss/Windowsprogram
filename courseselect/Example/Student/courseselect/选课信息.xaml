<Page x:Class="courseselect.Example.Student.courseselect.选课信息"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:courseselect.Example.Student.courseselect"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="选课信息">

    <Grid>
        <DataGrid x:Name="CourseInfoDataGrid" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="课程ID" Binding="{Binding cid}" />
                <DataGridTextColumn Header="课程名称" Binding="{Binding cname}" />
                <DataGridTextColumn Header="课程类型" Binding="{Binding  ckind}" />
                <DataGridTextColumn Header="上课学期" Binding="{Binding  cyear}" />
                <DataGridTextColumn Header="上课周" Binding="{Binding  cweek}" />
                <DataGridTextColumn Header="上课日" Binding="{Binding  cday}" />
                <DataGridTextColumn Header="上课时间" Binding="{Binding  ctime}" />
                <DataGridTextColumn Header="上课地点" Binding="{Binding cplace}" />
                <DataGridTextColumn Header="开设学院" Binding="{Binding  ccollege}" />
                <DataGridTextColumn Header="学分" Binding="{Binding ccredit}" />
                <DataGridTextColumn Header="考察方式" Binding="{Binding  ctest}" />
                <DataGridTextColumn Header="教师姓名" Binding="{Binding TeacherName}" />
                <DataGridTextColumn Header="教师学院" Binding="{Binding TeacherCollege}" />
                <DataGridTextColumn Header="教师部门" Binding="{Binding TeacherDepartment}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
