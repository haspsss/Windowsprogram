<Page x:Class="courseselect.Example.Student.PersonalInformation.MyInformation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:courseselect.Example.Student.PersonalInformation"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="我的信息">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="LightGoldenrodYellow" />
            <Setter Property="FontWeight" Value="bold"/>
            <Setter Property="Height" Value="25"/>
        </Style>
        <Style TargetType="TextBox" >
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Button Content="修改密码" HorizontalAlignment="Left" Margin="50,1,0,0" VerticalAlignment="Top" Click="Changepwbtn_Click"/>
        <Label Content="学号：" HorizontalAlignment="Left" Margin="55,50,0,0" VerticalAlignment="Top"/>
        <Label Content="姓名：" HorizontalAlignment="Left" Margin="205,50,0,0" VerticalAlignment="Top"/>
        <Label Content="性别：" HorizontalAlignment="Left" Margin="345,50,0,0" VerticalAlignment="Top"/>
        <Label Content="出生日期：" HorizontalAlignment="Left" Margin="55,100,0,0" VerticalAlignment="Top"/>
        <Label Content="学院：" HorizontalAlignment="Left" Margin="230,100,0,0" VerticalAlignment="Top"/>
        <Label Content="专业：" HorizontalAlignment="Left" Margin="405,100,0,0" VerticalAlignment="Top"/>
        <Label Content="政治面貌：" HorizontalAlignment="Left" Margin="55,150,0,0" VerticalAlignment="Top"/>
        <Label Content="联系方式：" HorizontalAlignment="Left" Margin="225,150,0,0" VerticalAlignment="Top"/>
      

        <TextBox x:Name="SidTextBox" HorizontalAlignment="Left" Margin="95,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
        <TextBox x:Name="NameTextBox" HorizontalAlignment="Left" Margin="245,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
        <TextBox x:Name="SexTextBox" HorizontalAlignment="Left" Margin="390,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
        <TextBox x:Name="BirthTextBox" HorizontalAlignment="Left" Margin="120,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
        <TextBox x:Name="CollegeTextBox" HorizontalAlignment="Left" Margin="270,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="135" IsReadOnly="True"/>
        <TextBox x:Name="MajorTextBox" HorizontalAlignment="Left" Margin="445,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" IsReadOnly="True"/>
        <TextBox x:Name="PoliticalTextBox" HorizontalAlignment="Left" Margin="120,155,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
        <TextBox x:Name="PhoneTextBox" HorizontalAlignment="Left" Margin="290,155,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" IsReadOnly="True"/>
    </Grid>
</Page>