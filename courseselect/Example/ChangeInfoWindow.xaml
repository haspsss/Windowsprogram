<Window x:Class="courseselect.Example.ChangeInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:courseselect.Example"
        mc:Ignorable="d"
        Title="修改我的信息" Height="450" Width="800">

    <Grid>

        <Label Content="姓名：" HorizontalAlignment="Left" Margin="58,50,0,0" VerticalAlignment="Top"/>
        <TextBox  x:Name="Name" HorizontalAlignment="Left" Margin="100,55,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"  />
        <Label Content="性别：" HorizontalAlignment="Left" Margin="258,50,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.272,0.188"/>
        <Label Content="出生日期：" HorizontalAlignment="Left" Margin="458,50,0,0" VerticalAlignment="Top"/>
        <Label Content="学院：" HorizontalAlignment="Left" Margin="58,100,0,0" VerticalAlignment="Top"/>
        <Label Content="专业：" HorizontalAlignment="Left" Margin="258,100,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.389,-0.109"/>
        <Label Content="政治面貌：" HorizontalAlignment="Left" Margin="458,100,0,0" VerticalAlignment="Top"/>
        <Label Content="联系方式:" HorizontalAlignment="Left" Margin="58,150,0,0" VerticalAlignment="Top"/>
        <TextBox Name="sex" HorizontalAlignment="Left" Margin="300,55,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="birthdate" HorizontalAlignment="Left" Margin="520,55,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" />
        <TextBox Name="college" HorizontalAlignment="Left" Margin="100,105,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" />
        <TextBox Name="major" HorizontalAlignment="Left" Margin="300,105,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" />
        <TextBox Name="political" HorizontalAlignment="Left" Margin="520,105,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" />
        <TextBox Name="phone" HorizontalAlignment="Left" Margin="120,155,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" />
        <Button Name="Check_ChangeInfobtn" Content="确认修改" HorizontalAlignment="Left" Margin="549,184,0,0" VerticalAlignment="Top" Width="60" Height="30" Background="BlanchedAlmond" Foreground="Black" Click="Check_ChangeInfo_Click"/>

    </Grid>
</Window>
